# MySQL 8.4 Database Configuration
MYSQL_DATABASE=nexus
MYSQL_USER=nexus_user
MYSQL_PASSWORD=nexus_pass
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_HOST_PORT=3307
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/nexus?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=nexus_user
SPRING_DATASOURCE_PASSWORD=nexus_pass

# AI Model Provider Configuration (Server-Side Only - Optional)
# Amazon Bedrock / Google Gemini / OpenAI
AI_PROVIDER=GEMINI
AI_MODEL=gemini-1.5-pro
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Application Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8080
BACKEND_INTERNAL_URL=http://localhost:8080
